# Copia este archivo a .env (no lo subas a Git). Para el despliegue en Render/Fly, define estas
# variables en el panel de la plataforma en vez de usar el archivo.

# OBLIGATORIA: contraseña para entrar al panel de administración. Usa una larga.
ADMIN_PASSWORD=cambia-esta-clave

# Opcional: solo estos dominios de correo pueden crear cuenta (separados por comas).
# Déjala vacía para aceptar cualquier correo.
ALLOWED_EMAIL_DOMAINS=

# Oraciones que recibe cada alumno (el admin puede cambiarlo después desde el panel).
SENTENCES_PER_STUDENT=15
