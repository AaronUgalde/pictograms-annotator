# Copia este archivo a .env para desarrollo local (no lo subas a Git).
# En Render, define estas variables en el panel del servicio.

# OBLIGATORIA: base de datos PostgreSQL. En Neon: proyecto > Connect > connection string.
DATABASE_URL=postgresql://usuario:clave@servidor.neon.tech/neondb?sslmode=require

# OBLIGATORIA: contraseña para entrar al panel de administración. Usa una larga.
ADMIN_PASSWORD=cambia-esta-clave

# Opcional: solo estos dominios de correo pueden crear cuenta (separados por comas).
# Déjala vacía para aceptar cualquier correo.
ALLOWED_EMAIL_DOMAINS=

# Oraciones que recibe cada alumno (el admin puede cambiarlo después desde el panel).
SENTENCES_PER_STUDENT=15
